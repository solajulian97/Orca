//@version=6
strategy("NinjaTrader Automated Executions v6", overlay=true, calc_on_every_tick=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// --- Settings ---
group_main = "Visual Settings"
show_labels     = input.bool(true, "Show Labels", group=group_main)
show_boxes      = input.bool(false, "Show Shaded PnL Boxes", group=group_main)
box_opacity     = input.int(10, "Box Opacity (0-100)", minval=0, maxval=100, group=group_main)

// --- Colors ---
color_long  = color.new(#0088FF, 0)
color_short = color.new(#FF4444, 0)

// --- Drawing Logic ---
// We use a function to pull trade data and render the markers/lines
// TradingView strategies follow FIFO for closed trades by default.

if barstate.islast
    for i = 0 to strategy.closedtrades - 1
        float entry_p = strategy.closedtrades.entry_price(i)
        float exit_p  = strategy.closedtrades.exit_price(i)
        int entry_t   = strategy.closedtrades.entry_time(i)
        int exit_t    = strategy.closedtrades.exit_time(i)
        float pnl     = strategy.closedtrades.profit(i)
        
        // Determine color based on pnl/direction
        color dir_color = pnl >= 0 ? color_long : color_short
        
        // 1. Draw Execution Line
        line.new(entry_t, entry_p, exit_t, exit_p, xloc=xloc.bar_time, color=dir_color, width=2, style=line.style_solid)
        
        // 2. Markers
        label.new(entry_t, entry_p, "", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.green, 10), style=label.style_triangleup, size=size.tiny)
        label.new(exit_t, exit_p, "", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.red, 10), style=label.style_triangledown, size=size.tiny)
        
        // 3. Shaded Background Box
        if show_boxes
            box.new(entry_t, entry_p, exit_t, exit_p, xloc=xloc.bar_time, bgcolor=color.new(dir_color, 100 - box_opacity), border_color=color.new(color.black, 100))
            
        // 4. Labels
        if show_labels
            string label_text = "Trade #" + str.tostring(i + 1) + "\nPnL: " + str.tostring(pnl, "#.##")
            label.new(exit_t, exit_p, label_text, xloc=xloc.bar_time, yloc=yloc.price, textcolor=color.white, color=color.new(color.black, 40), style=label.style_label_left, size=size.small, textalign=text.align_left)

// --- AUTOMATION INSTRUCTIONS ---
// Note: Pine Script cannot read your live broker executions.
// To use this visualizer, your specific trading logic must be coded below 
// so the script itself generates the orders.
// Example:
// if ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
//     strategy.entry("Long", strategy.long)
