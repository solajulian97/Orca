//@version=6
indicator("NinjaTrader Style Executions v6 (Manual)", overlay=true, max_lines_count=100, max_labels_count=100, max_boxes_count=100)

// --- Settings ---
group_main = "Visual Settings"
show_executions = input.bool(true, "Show Past Executions", group=group_main)
show_labels     = input.bool(true, "Show Labels", group=group_main)
show_boxes      = input.bool(false, "Show Shaded PnL Boxes", group=group_main)
box_opacity     = input.int(10, "Box Opacity (0-100)", minval=0, maxval=100, group=group_main)

color_long  = color.new(#0088FF, 0)
color_short = color.new(#FF4444, 0)

// --- Trade Logic Function ---
draw_trade(id, active, side, entry_time, entry_price, exit_time, exit_price, stop_loss) =>
    if active and show_executions and barstate.islast
        bool is_long = (side == "Long")
        color dir_color = is_long ? color_long : color_short
        
        line.new(entry_time, entry_price, exit_time, exit_price, xloc=xloc.bar_time, color=dir_color, width=2, style=line.style_solid)
        label.new(entry_time, entry_price, "", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.green, 10), style=label.style_triangleup, size=size.tiny)
        label.new(exit_time, exit_price, "", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.red, 10), style=label.style_triangledown, size=size.tiny)
        
        if show_boxes
            box.new(entry_time, entry_price, exit_time, exit_price, xloc=xloc.bar_time, bgcolor=color.new(dir_color, 100 - box_opacity), border_color=color.new(color.black, 100))
            
        float pnl = (exit_price - entry_price) * (is_long ? 1 : -1)
        float rr = math.abs(pnl) / math.max(0.00001, math.abs(entry_price - stop_loss))
        
        if show_labels
            string label_text = "Trade #" + str.tostring(id) + "\nSide: " + side + "\nPnL: " + str.tostring(pnl, "#.##") + "\nR/R: " + str.tostring(rr, "#.##")
            label.new(exit_time, exit_price, label_text, xloc=xloc.bar_time, yloc=yloc.price, textcolor=color.white, color=color.new(color.black, 80), style=label.style_label_left, size=size.small, textalign=text.align_left)

// --- Manual Trade Inputs ---
// Using 10 slots for ample manual tracking
t1_active = input.bool(false, "Trade 1 Active", inline="T1", group="Trade 1")
t1_side   = input.string("Long", "", options=["Long", "Short"], inline="T1", group="Trade 1")
t1_et = input.time(0, "Entry Time", group="Trade 1"); t1_ep = input.float(0.0, "Entry Price", group="Trade 1")
t1_xt = input.time(0, "Exit Time", group="Trade 1");  t1_xp = input.float(0.0, "Exit Price", group="Trade 1"); t1_sl = input.float(0.0, "Stop Loss", group="Trade 1")
draw_trade(1, t1_active, t1_side, t1_et, t1_ep, t1_xt, t1_xp, t1_sl)

t2_active = input.bool(false, "Trade 2 Active", inline="T2", group="Trade 2")
t2_side   = input.string("Long", "", options=["Long", "Short"], inline="T2", group="Trade 2")
t2_et = input.time(0, "Entry Time", group="Trade 2"); t2_ep = input.float(0.0, "Entry Price", group="Trade 2")
t2_xt = input.time(0, "Exit Time", group="Trade 2");  t2_xp = input.float(0.0, "Exit Price", group="Trade 2"); t2_sl = input.float(0.0, "Stop Loss", group="Trade 2")
draw_trade(2, t2_active, t2_side, t2_et, t2_ep, t2_xt, t2_xp, t2_sl)

